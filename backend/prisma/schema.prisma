// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  SENT_TO_KITCHEN
  PREPARING
  COMPLETED
  PAID
  CANCELLED
}

enum KdsItemStatus {
  PENDING
  PREPARING
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BOGO
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum SessionStatus {
  OPEN
  CLOSED
}

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  passwordHash  String
  role          UserRole    @default(EMPLOYEE)
  status        UserStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  orders        Order[]

  @@map("users")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String?
  imageUrl  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model Product {
  id              String      @id @default(uuid())
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  imageUrl        String?
  price           Decimal     @db.Decimal(10, 2)
  taxRate         Decimal     @db.Decimal(5, 2)
  unitOfMeasure   String?
  preparationTime Int?
  isKdsVisible    Boolean     @default(true)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]

  @@index([categoryId])
  @@map("products")
}

model Floor {
  id          String    @id @default(uuid())
  name        String    @unique
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tables      RestaurantTable[]

  @@index([isActive])
  @@map("floors")
}

model RestaurantTable {
  id            String      @id @default(uuid())
  floorId       String
  floor         Floor       @relation(fields: [floorId], references: [id], onDelete: Cascade)
  tableNumber   String
  seats         Int
  status        TableStatus @default(AVAILABLE)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orders        Order[]

  @@unique([floorId, tableNumber])
  @@index([floorId])
  @@index([status])
  @@map("restaurant_tables")
}

model Customer {
  id            String    @id @default(uuid())
  name          String
  email         String?
  phoneNumber   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]

  @@index([name])
  @@index([email])
  @@map("customers")
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique
  sessionId         String
  session           Session       @relation(fields: [sessionId], references: [id])
  tableId           String
  table             RestaurantTable @relation(fields: [tableId], references: [id])
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  createdByUserId   String
  createdByUser     User          @relation(fields: [createdByUserId], references: [id])
  status            OrderStatus   @default(DRAFT)
  subtotal          Decimal       @db.Decimal(10, 2)
  taxTotal          Decimal       @db.Decimal(10, 2)
  discountTotal     Decimal       @db.Decimal(10, 2)
  grandTotal        Decimal       @db.Decimal(10, 2)
  notes             String?
  sentToKitchenAt   DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  orderItems        OrderItem[]
  payments          Payment[]

  @@index([sessionId])
  @@index([tableId])
  @@index([customerId])
  @@index([createdByUserId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                    String        @id @default(uuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String
  product               Product       @relation(fields: [productId], references: [id])
  productNameSnapshot   String
  unitPriceSnapshot     Decimal       @db.Decimal(10, 2)
  taxRateSnapshot       Decimal       @db.Decimal(5, 2)
  quantity              Int
  lineSubtotal          Decimal       @db.Decimal(10, 2)
  lineTax               Decimal       @db.Decimal(10, 2)
  lineDiscount          Decimal       @db.Decimal(10, 2)
  lineTotal             Decimal       @db.Decimal(10, 2)
  kdsStatus             KdsItemStatus @default(PENDING)
  createdAt             DateTime      @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id        String          @id @default(uuid())
  orderId   String          @unique
  amount    Float
  method    PaymentMethod
  status    PaymentStatus   @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  order     Order           @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Coupon {
  id                String    @id @default(uuid())
  code              String    @unique
  description       String
  discountPercentage Float
  minOrderAmount    Float?
  expiryDate        DateTime
  maxUsageCount     Int
  currentUsageCount Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("coupons")
}

model Promotion {
  id        String        @id @default(uuid())
  name      String
  description String
  type      PromotionType
  value     Float
  startDate DateTime
  endDate   DateTime
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("promotions")
}

model Session {
  id                String         @id @default(uuid())
  openedByUserId    String
  openedByUser      User           @relation(fields: [openedByUserId], references: [id])
  status            SessionStatus  @default(OPEN)
  openingAmount     Decimal?       @db.Decimal(10, 2)
  closingAmount     Decimal?       @db.Decimal(10, 2)
  totalSales        Decimal?       @db.Decimal(10, 2)
  totalOrders       Int            @default(0)
  openedAt          DateTime       @default(now())
  closedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  orders            Order[]

  @@index([status])
  @@index([openedByUserId])
  @@map("sessions")
}
